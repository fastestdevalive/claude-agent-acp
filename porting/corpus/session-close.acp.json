{
  "permission": "allow",
  "steps": [
    {"call": "initialize"},
    {"call": "request", "method": "session/new", "capture_session_id": true,
     "params": {"cwd": "$CWD", "mcpServers": []}},
    {"call": "request", "method": "session/close", "params": {"sessionId": "$SESSION"}},
    {"call": "request", "method": "session/prompt", "expect_error": true,
     "params": {"sessionId": "$SESSION", "prompt": [{"type": "text", "text": "after close"}]}},
    {"call": "request", "method": "session/close", "params": {"sessionId": "$SESSION"}}
  ]
}
