{
  "permission": "allow",
  "steps": [
    {
      "call": "initialize",
      "client_capabilities_meta": {
        "jetbrains": {
          "air": {
            "version": 1,
            "capabilities": [
              "sessionFailure"
            ]
          }
        }
      }
    },
    {
      "call": "session/new"
    },
    {
      "call": "request",
      "method": "session/prompt",
      "params": {
        "sessionId": "$SESSION",
        "prompt": [
          {
            "type": "text",
            "text": "dying turn"
          }
        ]
      },
      "expect_error": true
    },
    {
      "call": "sleep",
      "ms": 300
    },
    {
      "call": "request",
      "method": "session/set_mode",
      "params": {
        "sessionId": "$SESSION",
        "modeId": "plan"
      },
      "expect_error": true
    },
    {
      "call": "request",
      "method": "session/load",
      "params": {
        "sessionId": "$SESSION",
        "cwd": "$CWD",
        "mcpServers": []
      }
    },
    {
      "call": "session/prompt",
      "text": "alive turn"
    }
  ]
}