{
  "permission": "allow",
  "steps": [
    {"call": "initialize"},
    {"call": "session/new"},
    {"call": "request", "method": "session/set_mode",
     "params": {"sessionId": "$SESSION", "modeId": "plan"}},
    {"call": "request", "method": "session/resume", "expect_error": true,
     "params": {"sessionId": "$SESSION", "cwd": "relative/dir", "mcpServers": [],
                "additionalDirectories": ["/tmp"]}},
    {"call": "request", "method": "session/resume",
     "params": {"sessionId": "$SESSION", "cwd": "$CWD", "mcpServers": []}}
  ]
}
