{
  "permission": "allow",
  "steps": [
    {"call": "initialize"},
    {"call": "request", "method": "session/new", "capture_session_id": true,
     "params": {"cwd": "$CWD", "mcpServers": []}},
    {"call": "request", "method": "session/set_mode",
     "params": {"sessionId": "$SESSION", "modeId": "acceptEdits"}},
    {"call": "request", "method": "session/set_config_option",
     "params": {"sessionId": "$SESSION", "configId": "mode", "value": "plan"}},
    {"call": "request", "method": "session/set_mode",
     "params": {"sessionId": "$SESSION", "modeId": "auto"}}
  ]
}
