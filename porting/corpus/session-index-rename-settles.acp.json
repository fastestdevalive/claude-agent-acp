{
  "permission": "allow",
  "steps": [
    {"call": "initialize", "client_capabilities_meta": {"jetbrains": {"air": {"version": 1, "capabilities": ["sessionIndex"]}}}},
    {"call": "request", "method": "session/new", "capture_session_id": true,
     "params": {"cwd": "$CWD", "mcpServers": []}},
    {"call": "request", "method": "_session/rename", "params": {"sessionId": "$SESSION", "title": "Client name"}},
    {"call": "request", "method": "session/prompt", "params": {"sessionId": "$SESSION", "prompt": [{"type": "text", "text": "hello"}]}}
  ]
}
