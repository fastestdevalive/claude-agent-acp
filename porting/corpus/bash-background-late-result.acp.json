{
  "permission": "allow",
  "steps": [
    {
      "call": "initialize",
      "client_capabilities_meta": {
        "jetbrains": {
          "air": {
            "version": 1,
            "capabilities": [
              "asyncTasks"
            ]
          }
        }
      }
    },
    {
      "call": "session/new"
    },
    {
      "call": "session/prompt",
      "text": "run in background"
    },
    {
      "call": "sleep",
      "ms": 200
    }
  ]
}
