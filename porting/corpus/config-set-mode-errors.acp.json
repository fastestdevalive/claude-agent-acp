{
  "permission": "allow",
  "steps": [
    {
      "call": "initialize"
    },
    {
      "call": "request",
      "method": "session/new",
      "capture_session_id": true,
      "params": {
        "cwd": "$CWD",
        "mcpServers": []
      }
    },
    {
      "call": "request",
      "method": "session/set_mode",
      "params": {
        "sessionId": "$SESSION",
        "modeId": "bogus"
      },
      "expect_error": true
    },
    {
      "call": "request",
      "method": "session/set_mode",
      "params": {
        "sessionId": "$SESSION",
        "modeId": "dontAsk"
      },
      "expect_error": true
    },
    {
      "call": "request",
      "method": "session/set_config_option",
      "params": {
        "sessionId": "$SESSION",
        "configId": "mode",
        "value": "bogus"
      },
      "expect_error": true
    },
    {
      "call": "request",
      "method": "session/set_config_option",
      "params": {
        "sessionId": "$SESSION",
        "configId": "nope",
        "value": "x"
      },
      "expect_error": true
    }
  ]
}