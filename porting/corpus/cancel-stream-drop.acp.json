{
  "permission": "allow",
  "steps": [
    {
      "call": "initialize"
    },
    {
      "call": "session/new"
    },
    {
      "call": "session/prompt",
      "text": "long running",
      "no_wait": true
    },
    {
      "call": "wait_recv",
      "contains": "Working"
    },
    {
      "call": "session/cancel"
    },
    {
      "call": "session/wait"
    },
    {
      "call": "sleep",
      "ms": 500
    }
  ]
}