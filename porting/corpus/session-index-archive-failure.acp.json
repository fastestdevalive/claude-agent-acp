{
  "permission": "allow",
  "steps": [
    {"call": "initialize", "client_capabilities_meta": {"jetbrains": {"air": {"version": 1, "capabilities": ["sessionIndex"]}}}},
    {"call": "request", "method": "session/new", "capture_session_id": true,
     "params": {"cwd": "$CWD", "mcpServers": []}},
    {"call": "request", "method": "_session/archive", "expect_error": true, "params": {"sessionId": "$SESSION"}},
    {"call": "request", "method": "session/prompt", "params": {"sessionId": "$SESSION", "prompt": [{"type": "text", "text": "still usable"}]}},
    {"call": "wait_recv", "contains": "session_info_update"}
  ]
}
