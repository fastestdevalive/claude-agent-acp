{
  "permission": "allow",
  "steps": [
    {"call": "initialize"},
    {"call": "session/new"},
    {"call": "request", "method": "session/list", "params": {"cwd": "$CWD"}},
    {"call": "request", "method": "session/close", "params": {"sessionId": "$SESSION"}},
    {"call": "request", "method": "session/fork", "capture_session_id": true, "params": {"sessionId": "$SESSION", "cwd": "$CWD", "mcpServers": []}},
    {"call": "request", "method": "session/delete", "params": {"sessionId": "$SESSION"}}
  ]
}
