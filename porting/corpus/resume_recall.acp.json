{
  "permission": "allow",
  "steps": [
    {"call": "initialize"},
    {"call": "session/new"},
    {"call": "session/prompt", "text": "Remember: the secret word is banana. Reply with only: stored"},
    {"call": "request", "method": "session/close", "params": {"sessionId": "$SESSION"}},
    {"call": "request", "method": "session/resume", "capture_session_id": true, "params": {"sessionId": "$SESSION", "cwd": "$CWD", "mcpServers": []}},
    {"call": "session/prompt", "text": "What is the secret word I told you? Reply with only that word."}
  ]
}
